spring:
  application:
    name: {{ project_name }}
  datasource:
    url: ${DB_URL:jdbc:postgresql://localhost:5432/{{ project_name | replace('-', '_') }}}
    username: ${DB_USER:app}
    password: ${DB_PASSWORD:app}
  jpa:
    hibernate:
      ddl-auto: update
    open-in-view: false
server:
  port: ${PORT:8080}

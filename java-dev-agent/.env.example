# 複製為 .env 後修改。金鑰絕不可 commit。
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# 資料庫：留空用 SQLite（workspace/data/agent.db）；docker compose 啟動後可用 PostgreSQL
# DATABASE_URL=postgresql+psycopg://agent:agent@localhost:5433/agent

# LLM 預設（可在對話中修改）
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=qwen3.6:35b-a3b-coding-mxfp8
LLM_TEMPERATURE=0
LLM_CONTEXT_LENGTH=32768
LLM_MAX_OUTPUT_TOKENS=24000
LLM_THINKING=false
LLM_REQUEST_TIMEOUT_SECONDS=900

# 目標 GitHub repo（可在對話中修改）；token 未設定時會嘗試 `gh auth token`
DEFAULT_REPO_URL=https://github.com/ChunPingWang/ollama-agent-outcome.git
DEFAULT_REPO_BASE_BRANCH=main
# GITHUB_TOKEN=ghp_xxx

# Langfuse（docker compose 的 LANGFUSE_INIT_* 預設值）；留空則 tracing 為 no-op、System Prompt 存檔案
LANGFUSE_PUBLIC_KEY=pk-lf-local-dev
LANGFUSE_SECRET_KEY=sk-lf-local-dev
LANGFUSE_HOST=http://localhost:3000
PROMPT_STORE=auto

# Java 建置
JAVA_HOME=/opt/homebrew/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home
GRADLE_BIN=gradle
GRADLE_VERSION=9.8.2
GRADLE_TIMEOUT_SECONDS=1800

# SDD 流程
PIPELINE_MAX_FIX_ATTEMPTS=10
PIPELINE_MAX_PARSE_RETRIES=2
PIPELINE_STRICT_RED=false
